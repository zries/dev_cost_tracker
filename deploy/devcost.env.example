# /etc/devcost/devcost.env — read by systemd, NOT a shell file
# Restart the service after edits:  systemctl restart devcost

PORT=6767
HOST=0.0.0.0
NODE_ENV=production

# Persistent SQLite database
DATABASE_PATH=/var/lib/devcost/devcost.sqlite

# 64-char hex string. Replace before first boot.
SESSION_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32

# Initial admin (created on first boot only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Set to "false" if you want secure cookies disabled (e.g. behind plain HTTP on LAN)
COOKIE_SECURE=false

# 'display' shows update commands in the UI. 'oneclick' enables a real Update Now button
# (requires the install.sh sudoers/helper to also be in place — set this on the install command).
UPDATER_MODE=display
