    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "svelte": "^5.16.1",
    "svelte-check": "^4.1.1",
