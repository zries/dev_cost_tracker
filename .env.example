# Port the app listens on
PORT=8080

# Bind address (0.0.0.0 = all interfaces, needed for LAN access)
HOST=0.0.0.0

# Path to the SQLite database file. Should live on a persistent volume.
DATABASE_PATH=/var/lib/devcost/devcost.sqlite

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin credentials. Created on first boot if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Set to "production" in deployment
NODE_ENV=production
